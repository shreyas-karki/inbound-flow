# Copy to .env and fill in. Never commit .env.

# true = fake Salesforce, stub Starbridge, offline scoring. Slack prints to the console until a webhook is set.
# Each MOCK_* below overrides MOCK_MODE for one service.
MOCK_SALESFORCE=
MOCK_STARBRIDGE=false
# Set to false once ANTHROPIC_WORKSPACE_ID is filled in.
MOCK_CLAUDE=true
MOCK_MODE=true

# --- Salesforce (username + password + security token login) ---
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SF_API_VERSION=v62.0
# dry-run = read real data, log the writes it WOULD make. live = actually write.
SF_WRITE_MODE=dry-run
# Owner for new inbound contacts. Luis Acevedo is 005QD00000p42ViYAI.
SF_DEFAULT_OWNER_ID=

# --- Claude ---
# User-level keys (sk-ant-usr-…) also need the workspace ID (wrkspc_…) from console.anthropic.com → Workspaces.
ANTHROPIC_WORKSPACE_ID=
DRAFT_TIMEOUT_MS=30000
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
SCORING_TIMEOUT_MS=6000

# --- Starbridge (live when STARBRIDGE_API_KEY is set and MOCK_STARBRIDGE=false) ---
STARBRIDGE_API_KEY=
STARBRIDGE_TIMEOUT_MS=3000

# --- Slack incoming webhook for the inbound channel ---
SLACK_WEBHOOK_URL=

# --- Routing / calendars (Google Calendar appointment schedule links) ---
# Use the full calendar.google.com/calendar/appointments/schedules/… URL; calendar.app.google short links can't be embedded.
# Who signs the AI SDR reply, and which Gmail account the "Open as Gmail draft" link opens.
REPLY_FROM_NAME=
REPLY_FROM_EMAIL=
BDR_NAME=Luis
BDR_BOOKING_URL=
GM_NAME=Growth Manager
GM_BOOKING_URL=
