# Copy to .env and fill in. Never commit .env.

# true = fake Salesforce, stub Starbridge, offline scoring, Slack printed to console.
MOCK_MODE=true

# --- Salesforce (Connected App with OAuth client-credentials flow) ---
SF_LOGIN_URL=https://innovamat.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=v62.0
# dry-run = read real data, log the writes it WOULD make. live = actually write.
SF_WRITE_MODE=dry-run
# Owner for new inbound contacts. Luis Acevedo is 005QD00000p42ViYAI.
SF_DEFAULT_OWNER_ID=

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
SCORING_TIMEOUT_MS=6000

# --- Starbridge (stubbed for now) ---
STARBRIDGE_API_KEY=
STARBRIDGE_TIMEOUT_MS=3000

# --- Slack incoming webhook for the inbound channel ---
SLACK_WEBHOOK_URL=

# --- Routing / calendars (Google Calendar appointment schedule links) ---
BDR_NAME=Luis
BDR_BOOKING_URL=
GM_NAME=Growth Manager
GM_BOOKING_URL=
